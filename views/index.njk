{% extends "base.njk" %}

{% block pageHeader %}
  <header
    class="masthead"
    style="background-image: url('/assets/img/home-bg.jpg')"
  >
    <div class="container position-relative px-4 px-lg-5">
      <div class="row gx-4 gx-lg-5 justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">
          <div class="site-heading">
            <h1>Clean Blog</h1>
            <span class="subheading">A Blog Theme by Saifur Rahman</span>
          </div>
        </div>
      </div>
    </div>
  </header>
{% endblock %}

{% block blogList %}
  <div class="container px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7">
        {% for blogPost in blogPosts %}
          <!-- Post preview-->
          <div class="post-preview">
            <a href="/post/{{ blogPost.slug }}"
              ><h2 class="post-title">{{ blogPost.title }}</h2>
              {% if blogPost.teaser %}
                <h3 class="post-subtitle">{{ blogPost.teaser }}</h3>
              {% endif %}
            </a>
            <p class="post-meta">
              Posted by
              <a href="#!">{{ blogPost.author }}</a>
              on {{ blogPost.formattedDate }}
            </p>
          </div>
          <!-- Divider-->
          <hr class="my-4" />
        {% endfor %}
        <!-- Pager-->
        <div class="d-flex justify-content-end mb-4">
          <a class="btn btn-primary text-uppercase" href="#!">Older Posts →</a>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
